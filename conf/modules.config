process {
    withName: 'PGSC_CALC_MATCH_COMBINE|PGSC_CALC_SCORE_COMBINE|PGSC_CALC_REPORT|PGSC_CALC_CACHE_PACK' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            failOnError: true,
            saveAs: { filename -> filename.endsWith('.parquet') || filename == 'versions.yml' ? null : filename.tokenize('/').last() }
        ]
    }
    withName: PGSC_CALC_LOAD {
        publishDir = [
            path: { "${params.outdir}/sex_check/${meta.sampleset}/${meta.chrom}/${meta.shard}" },
            mode: params.publish_dir_mode,
            pattern: 'sex_check.tsv',
            failOnError: true,
            saveAs: { filename -> 'sex_check.tsv' }
        ]
    }
}
