nextflow_process {
    name "Test process pgsc_download"
    script "../main.nf"
    process "PGSC_CALC_DOWNLOAD"

    test("Should download scoring file in build GRCh38") {
        when {
            process {
                """
                input[0] = Channel.from(
                    [ pgs_id: "PGS001229", efo_id: [], pgp_id: [] ]
                )
                input[1] = Channel.from("GRCh38")
                """
            }
        }
        then {
            assertAll (
                // it was OK!
                { assert process.success },
                // one process launched
                { assert process.trace.tasks().size() == 1},
                { assert process.out.scorefiles[0].every { path(it).size() > 0 } }
            )
        }
    }

    test("Should download two scoring files in build GRCh37") {
        when {
            process {
                """
                input[0] = Channel.from(
                    [ pgs_id: "PGS001229 PGS000822", efo_id: [], pgp_id: [] ]
                )
                input[1] = Channel.from("GRCh37")
                """
            }
        }
        then {
            assertAll (
                { assert process.success },
                { assert process.trace.tasks().size() == 1 },
                { assert process.out.scorefiles[0].every { path(it).size() > 0 } }
            )
        }
    }

    test("Should download scoring files with publication ID") {
        when {
            process {
                """
                input[0] = Channel.from(
                    [ pgs_id: "", efo_id: "", pgp_id: "PGP000020" ]
                )
                input[1] = Channel.from("GRCh37")
                """
            }
        }
        then {
            assertAll (
                { assert process.success },
                { assert process.trace.tasks().size() == 1 },
                { assert process.out.scorefiles[0].every { path(it).size() > 0 } }
            )
        }
    }


    test("Should download scoring files with EFO term (trait)") {
        when {
            process {
                """
                input[0] = Channel.from(
                    [ pgs_id: "", pgp_id: "", efo_id: "EFO_0009460" ]
                )
                input[1] = Channel.from("GRCh37")
                """
            }
        }
        then {
            assertAll (
                { assert process.success },
                { assert process.trace.tasks().size() == 1 },
                // The trait has at least one directly associated score.
                { assert process.out.scorefiles.get(0).size() >= 1 }
            )
        }
    }

    test("Test stub") {

    options "-stub"

        when {
            process {
                """
                input[0] = Channel.from(
                    [ pgs_id: "PGS001229", efo_id: [], pgp_id: [] ]
                )
                input[1] = Channel.from("GRCh37")
                """
            }
        }

        then {
            assert process.success
        }
    }
}
