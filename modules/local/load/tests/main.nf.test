nextflow_process {
    name "Test process pgsc_calc_load"
    script "../main.nf"
    process "PGSC_CALC_LOAD"
    tag "module"

    test("Load 1000G vcf") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [sampleset: "1000G", chrom: "ALL", shard: "fixture", file_format: "vcf", absent_variants: "unobserved"],
                    file("$baseDir/tests/data/vcf/PGS000586_GRCh38.vcf.gz"), file("$baseDir/assets/optional_input/BGEN_SAMPLE_NO_FILE"), file("$baseDir/tests/data/vcf/PGS000586_GRCh38.vcf.gz.csi")
                ])
                input[1] = file("$baseDir/tests/data/normalised_PGS000586_hmPOS_GRCh38.txt.gz")
                input[2] = file("$baseDir/assets/optional_input/ZARR_ZIP_NO_FILE")
                input[3] = 5000
                input[4] = file("$baseDir/tests/pgs000586/sex.tsv")
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.loaded[0][1] + '/genotypes.zarr.zip').size() > 0 },
                { assert path(process.out.loaded[0][1] + '/samples.json').size() > 0 }
            )
        }
    }

    test("Load 1000G bgen") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [sampleset: "1000G", chrom: "ALL", shard: "fixture", file_format: "bgen", absent_variants: "unobserved"],
                    file("$baseDir/tests/data/bgen/PGS000586_GRCh38.bgen"), file("$baseDir/tests/data/bgen/PGS000586_GRCh38.sample"), file("$baseDir/tests/data/bgen/PGS000586_GRCh38.bgen.bgi")
                ])
                input[1] = file("$baseDir/tests/data/normalised_PGS000586_hmPOS_GRCh38.txt.gz")
                input[2] = file("$baseDir/assets/optional_input/ZARR_ZIP_NO_FILE")
                input[3] = 5000
                input[4] = file("$baseDir/tests/pgs000586/sex.tsv")
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.loaded[0][1] + '/genotypes.zarr.zip').size() > 0 },
                { assert path(process.out.loaded[0][1] + '/samples.json').size() > 0 }
            )
        }
    }
}
