nextflow_workflow {
    name "Test score workflow"
    script "../main.nf"
    workflow "PGSC_CALC"

    test("unified bgen should calculate") {
        when {
            params {
                scorefile = "../../../tests/pgs000586/PGS000586_autosomes.txt.gz"
                target_build = "GRCh38"
            }
            workflow {
                """
                input[0] = Channel.of(
                    [ [ sampleset: "1000G", chrom: "ALL", file_format: "bgen", genotyping_method: "array", absent_variants: "unobserved", shard: "fixture" ],
                        file("../../../tests/data/bgen/PGS000586_GRCh38.bgen", checkIfExists: true),
                        file("../../../tests/data/bgen/PGS000586_GRCh38.sample", checkIfExists: true),
                    ]
                )
                input[1] = "GRCh38"
                input[2] = [pgs_id: "", pgp_id: "", efo_id: ""]
                input[3] = file("../../../tests/pgs000586/PGS000586_autosomes.txt.gz", checkIfExists: true)
                input[4] = file("$baseDir/assets/optional_input/CHAIN_NO_FILE") // chain file
                input[5] = file("$baseDir/assets/optional_input/ZARR_ZIP_NO_FILE") // zarr archive file
                input[6] = Channel.value(5000)
                input[7] = Channel.empty()
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                {
                    def actual = path(workflow.out.scores[0]).linesGzip
                        .drop(1).collect { it.split(',').toList() }
                        .collect { [it[2], it[6], it[7]] }.sort { it[0] }
                    def expected = path("$baseDir/tests/pgs000586/data/v2_scores.txt.gz").linesGzip
                        .drop(1).collect { it.split(',').toList() }
                        .collect { [it[0], it[2], it[4]] }.sort { it[0] }
                    ScoreUtils.assertScoresMatch(actual, expected)
                }
            )
        }
    }

