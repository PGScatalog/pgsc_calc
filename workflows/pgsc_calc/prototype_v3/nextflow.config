// Run inside the image: direct local execution, no nested runtime or solving.
process {
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    errorStrategy = 'terminate'
}
executor.queueSize = 2
docker.enabled = false
singularity.enabled = false
conda.enabled = false
wave.enabled = false
params {
    input = null
    scorefile = null
    outdir = 'results'
    min_overlap = 0.75
    keep_ambiguous = false
    keep_multiallelic = false
    ignore_strand_flips = false
}
trace {
    enabled = true
    file = 'trace.tsv'
    overwrite = true
}
